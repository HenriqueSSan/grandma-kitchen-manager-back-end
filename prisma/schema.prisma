generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model Product {
    id         Int    @id @default(autoincrement())
    name       String @unique
    qty        Int
    qty_minium Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    

    @@map("product")
}
